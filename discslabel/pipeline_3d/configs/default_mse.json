{
    "data_json": "data_t1w_t2w",
    "out_name": "data_t1w_t2w",
    "run_name": "data_t1w_t2w_UNet3D_default_MSE",
    "debug": false,

    "steps": {
        "download": false,
        "prepare": false,
        "train": true,
        "tune": true,
        "inference": false,
        "evaluate": true
    },

    "orientation": "RPI",
    "resolution": "1x1x1",
    "label_sigma": 2.0,

    "spine_disc_min_label": 60,

    "model_name": "UNet3D",
    "in_channels": 1,
    "patch_size": [96, 256, 256],
    "heatmap_sigma": 2.0,
    "heatmap_radius": 4,

    "batch_size": 2,
    "batch_size_valid": "auto",
    "num_workers": 16,
    "prefetch_factor": 4,
    "use_amp": true,

    "num_epochs": 500,
    "num_iterations_per_epoch": 250,
    "num_val_iterations_per_epoch": 50,
    "oversample_foreground_percent": 0.33,
    "deep_supervision": true,
    "save_model_step": 10,

    "optimizer": "AdamW",
    "lr": 3e-4,
    "weight_decay": 3e-5,
    "beta1": 0.9,
    "beta2": 0.999,
    "momentum": 0.99,

    "loss_name": "MSE",
    "peak_threshold": 0.3,

    "val_every": 5,
    "val_max_images": null,
    "val_tolerance_mm": 10.0,
    "val_ema_alpha": 0.9,

    "tune_peak_thresholds": [0.1, 0.15, 0.2, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5, 0.55, 0.6],
    "tune_min_peak_distances": [4, 6, 8, 10, 12, 15, 20],

    "aug_config": "transform_params_one-sequence-to-segment-them-all.json",

    "wandb": {
        "project": "discs-labeling-multicontrast",
        "entity": null,
        "run_name": null,
        "log_images_every": 1
    },

    "inference_split": "test",
    "inference_save_images": true,
    "inference_overlap": 0.5,
    "inference_min_peak_distance": 10.0,
    "inference_batch_size": "auto"
}
