{
    "data_json": "data_t1w_t2w_PSIR_STIR",
    "out_name": "data_t1w_t2w_PSIR_STIR",
    "run_name": "data_t1w_t2w_PSIR_STIR_UNet_MSE",
    "debug": false,

    "steps": {
        "download": false,
        "prepare": false,
        "train": true,
        "skeleton": true,
        "tune": true,
        "inference": false,
        "evaluate": true
    },

    "orientation": "RPI",
    "resolution": "1x1x1",
    "label_sigma": 2.0,

    "spine_disc_min_label": 60,
    "data_cache": true,
    "midline_jitter": 2,

    "model_name": "UNet",
    "in_channels": 1,
    "slab_thickness_mm": 10.0,
    "slab_prob": 0.5,
    "patch_size": [96, 320, 320],
    "heatmap_sigma": 1.0,
    "heatmap_radius": 2,

    "batch_size": "auto",
    "batch_size_valid": "auto",
    "num_workers": "auto",
    "prefetch_factor": 4,
    "use_amp": true,

    "num_epochs": 500,
    "num_iterations_per_epoch": 250,
    "num_val_iterations_per_epoch": 50,
    "oversample_foreground_percent": 0.33,
    "deep_supervision": true,
    "save_model_step": 10,

    "optimizer": "AdamW",
    "lr": 3e-4,
    "weight_decay": 3e-5,
    "beta1": 0.9,
    "beta2": 0.999,
    "momentum": 0.99,

    "loss_name": "MSE",
    "peak_threshold": 0.3,

    "val_every": 1,
    "val_max_images": null,
    "val_tolerance_mm": 10.0,
    "val_ema_alpha": 0.9,

    "tune_peak_thresholds": [0.1, 0.15, 0.2, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5, 0.55, 0.6],
    "tune_min_peak_distances": [4, 6, 8, 10, 12, 15, 20],
    "tune_skeleton_z_thresholds": [2.0, 2.5, 3.0, 3.5, 4.0, 5.0],

    "skeleton_z_threshold": 3.0,
    "skeleton_max_missing": 3,
    "skeleton_max_skipped": 3,

    "aug_config": "transform_params_one-sequence-to-segment-them-all.json",

    "elastic_config": {
        "kernel_size": [63, 63],
        "sigma": [32.0, 32.0],
        "alpha": [2.0, 2.0],
        "resample": 1,
        "padding_mode": "zeros",
        "p": 0.5
    },

    "artifact_config": {
        "p": 0.3,
        "random_pick": true,
        "retain_stats": true,
        "motion": {"degrees": 10, "translation": 10, "num_transforms": 2},
        "ghosting": {"num_ghosts": [4, 10], "axes": [0, 1, 2], "intensity": [0.5, 1.0]},
        "spike": {"num_spikes": 1, "intensity": [1, 2]},
        "bias_field": {"coefficients": 0.5, "order": 3},
        "blur": {"std": [0, 2]},
        "noise": {"mean": 0, "std": [0, 0.25]},
        "swap": {"patch_size": 15, "num_iterations": 100}
    },

    "lowres_si_config": {
        "p": 0.25,
        "spacing": [1.0, 5.0],
        "axis": "SI",
        "down_mode": "area",
        "up_mode": "linear"
    },

    "wandb": {
        "project": "discs-labeling-multicontrast",
        "entity": null,
        "run_name": null,
        "log_images_every": 1
    },

    "inference_split": "test",
    "inference_save_images": true,
    "inference_input_mode": "avg",
    "inference_overlap": 0.5,
    "inference_min_peak_distance": 10.0,
    "inference_batch_size": "auto",
    "inference_num_workers": "auto",
    "inference_skeleton": "off",
    "evaluate_skeleton_compare": true
}
