    "batch_size": 2,
    "batch_size_valid": 1,
    "num_workers": 2,

    "train_max_epoch": 400,
    "epoch_patience": 10,
    "save_model_step": 10,

    "lr": 1e-4,
    "beta1": 0.9,
    "beta2": 0.999,
    "scheduler_step_size": 10,
    "scheduler_gamma": 0.9,

    "loss_name": "focalLoss",
    "peak_threshold": 0.3,

    "aug_config": null,

    "inference_split": "test",
    "inference_save_images": true
}
