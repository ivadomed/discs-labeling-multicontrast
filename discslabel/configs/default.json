{
    "data_json": "whole-spine",
    "out_name": "whole-spine",
    "run_name": "whole-spine_UNet_default",
    "debug": false,

    "steps": {
        "download": false,
        "prepare": true,
        "train": false,
        "inference": false
    },

    "orientation": "RPI",
    "resolution": "1x1x1",
    "label_sigma": 2.0,

    "spine_disc_min_label": 60,

    "model_name": "UNet",
