{
    "model_name": "UNet",
    "in_channels": 1,
    "image_height": 512,
    "image_width": 512,
    "heatmap_sigma": 8.0,
    "heatmap_radius": 20,

    "batch_size": 8,
    "batch_size_valid": 2,
    "num_workers": 2,

    "train_max_epoch": 400,
    "epoch_patience": 10,
    "save_model_step": 10,

    "lr": 1e-4,
    "beta1": 0.9,
    "beta2": 0.999,
    "scheduler_step_size": 10,
    "scheduler_gamma": 0.9,

    "loss_name": "focalLoss",
    "intensity_jitter": 0.1,
    "vertical_flip_prob": 0.0,

    "peak_threshold": 0.3
}
